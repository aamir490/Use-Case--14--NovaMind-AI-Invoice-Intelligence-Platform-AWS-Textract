# ─────────────────────────────────────────────────────────────────────────────
# Root .env.example
# Copy the relevant section to the right place and fill in real values.
# NEVER commit real values. This file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend  →  copy to frontend/.env.local ─────────────────────────────────
# These are output by CDK after deploy. Find them in:
#   AWS Console → CloudFormation → InvoiceApi-dev → Outputs
#   AWS Console → CloudFormation → InvoiceAuth-dev → Outputs

VITE_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/v1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── GitHub Actions Secrets (set in repo Settings → Secrets → Actions) ─────────
# AWS_DEPLOY_ROLE_ARN      = arn:aws:iam::123456789012:role/GitHubActionsDeployRole
# FRONTEND_BUCKET          = invoice-frontend-hosting-dev-123456789012
# CF_DISTRIBUTION_ID       = EXXXXXXXXXXXXX
# VITE_API_URL             = (same as above)
# VITE_COGNITO_USER_POOL_ID         = (same as above)
# VITE_COGNITO_USER_POOL_CLIENT_ID  = (same as above)

# ── Local Lambda testing (optional — used with SAM local or pytest) ────────────
AWS_DEFAULT_REGION=us-east-1
INVOICES_TABLE=invoices-dev
JOBS_TABLE=processing-jobs-dev
UPLOADS_BUCKET=invoice-uploads-dev-123456789012
PROCESSED_BUCKET=invoice-processed-dev-123456789012
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
EVENTBRIDGE_BUS_NAME=invoice-platform
STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:invoice-processing-pipeline-dev
